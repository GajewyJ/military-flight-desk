{
  "name": "military-flight-desk",
  "private": true,
  "version": "0.2.1",
  "description": "Tactical flight dispatch and mission planning desk for Microsoft Flight Simulator 2020/2024 peacetime military sorties.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','release']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data:airports": "vite-node scripts/build-airport-data.ts",
    "electron": "electron electron/main.cjs",
    "electron:dev": "vite build && electron electron/main.cjs",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "geomagnetism": "^0.2.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
